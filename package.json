{
  "name": "automacao-planilhas",
  "version": "1.0.0",
  "description": "Automação WhatsApp para Google Planilhas - Windows Portable",
  "main": "main.js",
  "author": "RODRIGODESS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.1"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.automacaoplanilhas",
    "productName": "Automacao Planilhas",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      },
      {
        "from": "config.json",
        "to": "config.default.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "AutomacaoPlanilhas-Windows-Portable-v${version}.exe"
    }
  }
}